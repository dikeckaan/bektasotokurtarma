{
  "name": "bektas-oto-kurtarma",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bektas Oto Kurtarma - Istanbul Anadolu Yakasi 7/24 oto cekici ve yol yardim. Cloudflare Workers uzerinde statik site.",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && wrangler dev",
    "deploy": "node build.mjs && wrangler deploy",
    "preview": "node build.mjs && npx serve dist",
    "test": "node test/site-serialize.test.mjs && node test/geo.test.mjs",
    "audit": "node build.mjs > /dev/null && node tools/seo-audit.mjs",
    "duyur": "node tools/indexnow.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  }
}
