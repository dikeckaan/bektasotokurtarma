{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cekici-online",
  "main": "src/worker.js",
  "compatibility_date": "2025-08-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Bulunamayan yollarda dist/404.html gosterilir
    "not_found_handling": "404-page",
    // /kadikoy-oto-kurtarma -> /kadikoy-oto-kurtarma/ otomatik yonlendirme
    "html_handling": "auto-trailing-slash"
  },

  "vars": {
    // Kanonik alan adi. www ve diger hostlar buraya 301 atilir.
    "CANONICAL_HOST": "cekici.online"
  },

  "observability": { "enabled": true }

  // Yayina alirken:
  //   npx wrangler deploy
  // Ozel alan adi baglamak icin Cloudflare panelinde
  // Workers & Pages > bektas-oto-kurtarma > Settings > Domains & Routes
}
